generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workflow {
  id               String              @id @default(cuid())
  userId           String
  name             String
  description      String?
  definition       String
  status           String
  lastRunAt        DateTime?
  lastRunStatus    String?
  lastRunId        String?
  creditsConsumed  Int                 @default(0)
  isTemplate       Boolean             @default(false)
  templateCategory String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  webhooks         WebhookTrigger[]
  executions       WorkflowExecution[]
  schedules        WorkflowSchedule[]
  versions         WorkflowVersion[]

  @@unique([name, userId])
}

model WorkflowExecution {
  id              String    @id @default(cuid())
  workflowId      String
  userId          String
  status          String
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  duration        Int?
  creditsConsumed Int       @default(0)
  definition      String
  logs            String
  phases          String?
  output          String?
  error           String?
  createdAt       DateTime  @default(now())
  workflow        Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@index([status])
}

model WorkflowSchedule {
  id             String    @id @default(cuid())
  workflowId     String
  userId         String
  enabled        Boolean   @default(true)
  cronExpression String
  timezone       String    @default("UTC")
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workflow       Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@index([enabled])
  @@index([nextRunAt])
}

model UserBalance {
  userId    String   @id
  credits   Int      @default(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookTrigger {
  id              String    @id @default(cuid())
  workflowId      String
  userId          String
  enabled         Boolean   @default(true)
  webhookPath     String    @unique
  lastTriggeredAt DateTime?
  triggerCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workflow        Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@index([enabled])
}

model WorkflowVersion {
  id            String   @id @default(cuid())
  workflowId    String
  userId        String
  version       Int
  definition    String
  changeMessage String?
  createdAt     DateTime @default(now())
  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([userId])
}

model WorkflowStorage {
  id         String   @id @default(cuid())
  workflowId String
  userId     String
  key        String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([workflowId, key])
  @@index([workflowId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  workflowId String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([workflowId])
  @@index([action])
  @@index([createdAt])
}

model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  limitType   String
  count       Int      @default(0)
  windowStart DateTime @default(now())
  windowSize  Int      @default(3600)
  updatedAt   DateTime @updatedAt

  @@unique([userId, limitType])
  @@index([userId])
  @@index([windowStart])
}

model AlertConfig {
  id             String   @id @default(cuid())
  workflowId     String   @unique
  userId         String
  enabled        Boolean  @default(true)
  onSuccess      Boolean  @default(false)
  onFailure      Boolean  @default(true)
  emailEnabled   Boolean  @default(true)
  email          String?
  webhookEnabled Boolean  @default(false)
  webhookUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([enabled])
}

model Organization {
  id          String               @id @default(cuid())
  name        String
  description String?
  ownerId     String
  plan        String               @default("free")
  credits     Int                  @default(5000)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  members     OrganizationMember[]
  workflows   SharedWorkflow[]

  @@index([ownerId])
}

model OrganizationMember {
  id                 String       @id @default(cuid())
  orgId              String
  userId             String
  role               String
  canCreateWorkflow  Boolean      @default(true)
  canEditWorkflow    Boolean      @default(true)
  canDeleteWorkflow  Boolean      @default(false)
  canExecuteWorkflow Boolean      @default(true)
  canManageTeam      Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@index([role])
}

model SharedWorkflow {
  id             String        @id @default(cuid())
  workflowId     String        @unique
  orgId          String?
  shareType      String
  publicUrl      String?       @unique
  allowExecution Boolean       @default(true)
  allowClone     Boolean       @default(true)
  allowEdit      Boolean       @default(false)
  viewCount      Int           @default(0)
  cloneCount     Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([shareType])
  @@index([publicUrl])
}

model ExecutionMetrics {
  id          String   @id @default(cuid())
  executionId String
  nodeId      String
  taskType    String
  startTime   DateTime
  endTime     DateTime
  duration    Int
  memoryUsed  Int?
  cpuUsed     Float?
  status      String
  error       String?
  createdAt   DateTime @default(now())

  @@index([executionId])
  @@index([nodeId])
  @@index([taskType])
}

model FeatureFlag {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String?
  enabled           Boolean  @default(false)
  enabledFor        String?
  rolloutPercentage Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([name])
  @@index([enabled])
}
